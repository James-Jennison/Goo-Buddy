# Copy to .env for the published-image Compose contract. Do not put API keys,
# printer addresses, or credentials in this file; configure printers manually
# through Goo Buddy after a healthy local installation.
GOO_BUDDY_IMAGE=ghcr.io/james-jennison/goo-buddy:0.3.0-alpha.3
GOO_BUDDY_PLATFORM=linux/arm64
GOO_BUDDY_BIND_ADDRESS=127.0.0.1
GOO_BUDDY_PORT=8000
PUID=1000
PGID=1000
TZ=UTC
